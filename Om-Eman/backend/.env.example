NODE_ENV=development
PORT=3002

# PostgreSQL connection string used by Prisma CLI and the pg adapter.
DATABASE_URL="postgresql://mohamed:123456@localhost:5432/om_eman?schema=public"

# Comma-separated origins, or * for all.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007

APP_NAME=Om Eman
APP_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

# Auth (used by the future authentication module).
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Logging. The file is append-only; rotate/archive it externally later.
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email (optional in development).
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Om Eman <no-reply@om-eman.local>"

# Customer sessions (opaque bearer tokens stored hashed in the Session table).
SESSION_TTL_DAYS=30
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Google OAuth client ID. Used to validate Google ID token credentials
# ("aud" claim) for customer sign-in. Empty = Google sign-in disabled.
GOOGLE_CLIENT_ID=

# Cloudinary (image uploads). Required for product/category/banner/proof
# images; the browser uploads directly with a signature minted by the API.
CLOUDINARY_CLOUD_NAME=rf8hghkq
CLOUDINARY_API_KEY=354259729733368
CLOUDINARY_API_SECRET=3pb480Rgol0pMoQsja6yX700luo
