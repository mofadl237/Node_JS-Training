NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma CLI and the pg adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/om_eman?schema=public

# Comma-separated origins, or * for all.
CORS_ORIGIN=http://localhost:3000

APP_NAME=Om Eman
APP_TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP

# Auth (used by the future authentication module).
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Logging. The file is append-only; rotate/archive it externally later.
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Email (optional in development).
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Om Eman <no-reply@om-eman.local>"
