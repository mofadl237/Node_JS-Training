// Restaurant API schema.
// Money is stored as Decimal(12, 2) — never float — so totals stay exact.
// Ids are BigInt in the DB and serialized as strings by the API layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OfferType {
  PERCENTAGE
  BUNDLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]

  @@map("users")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  category    String?  @db.VarChar(80)
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItems OrderItem[]
  // PERCENTAGE offers point at one product through Offer.productId.
  offers     Offer[]     @relation("ProductPercentageOffers")
  // BUNDLE offers reference many products through OfferItem.
  offerItems OfferItem[]

  @@index([name])
  @@index([category])
  @@map("products")
}

model Offer {
  id              BigInt    @id @default(autoincrement())
  title           String    @db.VarChar(150)
  description     String?   @db.Text
  type            OfferType
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  bundlePrice     Decimal?  @map("bundle_price") @db.Decimal(12, 2)
  productId       BigInt?   @map("product_id")
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product?     @relation("ProductPercentageOffers", fields: [productId], references: [id], onDelete: Cascade)
  items       OfferItem[]
  orderOffers OrderOffer[]

  @@index([productId])
  @@index([type, isActive])
  @@map("offers")
}

model OfferItem {
  id        BigInt @id @default(autoincrement())
  offerId   BigInt @map("offer_id")
  productId BigInt @map("product_id")
  quantity  Int    @default(1)

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([offerId, productId])
  @@index([productId])
  @@map("offer_items")
}

model Order {
  id             BigInt      @id @default(autoincrement())
  userId         BigInt      @map("user_id")
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  orderOffers OrderOffer[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                BigInt  @id @default(autoincrement())
  orderId           BigInt  @map("order_id")
  productId         BigInt  @map("product_id")
  quantity          Int
  originalUnitPrice Decimal @map("original_unit_price") @db.Decimal(12, 2)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model OrderOffer {
  id             BigInt  @id @default(autoincrement())
  orderId        BigInt  @map("order_id")
  offerId        BigInt  @map("offer_id")
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([orderId, offerId])
  @@index([offerId])
  @@map("order_offers")
}
