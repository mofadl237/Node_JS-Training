NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_1"

# Redis (optional: remove/leave empty to disable caching)
REDIS_URL="redis://127.0.0.1:6379"
CACHE_TTL_SECONDS=60

# Logs (JSON lines written to this folder)
LOG_DIR="logs"

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN="*"
