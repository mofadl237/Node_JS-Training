
# 1. Base Image
FROM node:22-alpine

# 2. Working Directory
WORKDIR /app

# 3. Copy package files
COPY package*.json ./

# 4. Install dependencies
RUN npm ci

# 5. Copy application source code
COPY . .

# 6. Generate Prisma Client (if using Prisma)
RUN npx prisma generate

# 7. Expose application port
EXPOSE 3000

# 8. Start application
CMD ["npm", "start"]
